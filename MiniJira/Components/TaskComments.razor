        margin: 0;
    }
</style>

@code {
    [Parameter]
    public Guid TaskId { get; set; }

    [Parameter]
    public Guid ColumnId { get; set; }

    private List<TaskComment> comments = new();
    private Dictionary<(int Order, Guid ColumnId, string ColumnName, Column Column), List<TaskComment>> commentsByPhase = new();
    private string newCommentText = string.Empty;
    private bool isLoading = true;
    private bool isSaving = false;
    private Guid? editingCommentId = null;
    private string editCommentText = string.Empty;
    private bool showEmojiPicker = false;
    private ElementReference commentTextarea;
    private ElementReference editTextarea;

    private readonly string[] commonEmojis = new[]
    {
        "😀", "😃", "😄", "😁", "😅", "😂", "🤣", "😊",
        "😇", "🙂", "🙃", "😉", "😌", "😍", "🥰", "😘",
        "👍", "👎", "👏", "🙌", "👌", "✌️", "🤞", "🤝",
        "💪", "🙏", "✨", "⭐", "🎉", "🎊", "🎈", "🎁",
        "❤️", "💙", "💚", "💛", "🧡", "💜", "🖤", "🤍",
        "✅", "❌", "⚠️", "💡", "🔥", "⚡", "💯", "🚀"
    };

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        await LoadComments();
    }

    private async System.Threading.Tasks.Task LoadComments()
    {
        try
        {
            isLoading = true;

            using var scope = ServiceProvider.CreateScope();
            var dbContext = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            comments = await dbContext.TaskComments
                .Include(c => c.Column)
                    .ThenInclude(col => col.Translations)
                .Where(c => c.TaskId == TaskId)
                .OrderBy(c => c.CreatedAt)
                .ToListAsync();

            // Group comments by phase
            commentsByPhase = comments
                .GroupBy(c => (
                    Order: c.Column.Order,
                    ColumnId: c.ColumnId,
                    ColumnName: c.Column.Translations?.FirstOrDefault()?.Name ?? "Unknown",
                    Column: c.Column
                ))
                .ToDictionary(g => g.Key, g => g.ToList());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading comments: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async System.Threading.Tasks.Task AddComment()
    {
        if (string.IsNullOrWhiteSpace(newCommentText) || isSaving)
            return;

        try
        {
            isSaving = true;

            using var scope = ServiceProvider.CreateScope();
            var dbContext = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var comment = new TaskComment
            {
                Id = Guid.NewGuid(),
                TaskId = TaskId,
                ColumnId = ColumnId,
                Content = newCommentText.Trim(),
                CreatedAt = DateTime.UtcNow,
                CreatedBy = "User" // TODO: Replace with actual user when auth is implemented
            };

            dbContext.TaskComments.Add(comment);
            await dbContext.SaveChangesAsync();

            newCommentText = string.Empty;
            await LoadComments();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding comment: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void StartEditComment(TaskComment comment)
    {
        editingCommentId = comment.Id;
        editCommentText = comment.Content;
    }

    private void CancelEditComment()
    {
        editingCommentId = null;
        editCommentText = string.Empty;
    }

    private async System.Threading.Tasks.Task SaveEditComment()
    {
        if (string.IsNullOrWhiteSpace(editCommentText) || !editingCommentId.HasValue || isSaving)
            return;

        try
        {
            isSaving = true;

            using var scope = ServiceProvider.CreateScope();
            var dbContext = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var comment = await dbContext.TaskComments.FindAsync(editingCommentId.Value);
            if (comment != null)
            {
                comment.Content = editCommentText.Trim();
                comment.UpdatedAt = DateTime.UtcNow;
                await dbContext.SaveChangesAsync();

                editingCommentId = null;
                editCommentText = string.Empty;
                await LoadComments();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating comment: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async System.Threading.Tasks.Task DeleteComment(Guid commentId)
    {
        try
        {
            using var scope = ServiceProvider.CreateScope();
            var dbContext = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var comment = await dbContext.TaskComments.FindAsync(commentId);
            if (comment != null)
            {
                dbContext.TaskComments.Remove(comment);
                await dbContext.SaveChangesAsync();
                await LoadComments();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting comment: {ex.Message}");
        }
    }

    private void InsertFormatting(string prefix, string suffix, string placeholder)
    {
        newCommentText += prefix + placeholder + suffix;
    }

    private void InsertFormattingEdit(string prefix, string suffix, string placeholder)
    {
        editCommentText += prefix + placeholder + suffix;
    }

    private void ToggleEmojiPicker()
    {
        showEmojiPicker = !showEmojiPicker;
    }

    private void InsertEmoji(string emoji)
    {
        newCommentText += emoji;
        showEmojiPicker = false;
    }

    private void InsertEmojiEdit(string emoji)
    {
        editCommentText += emoji;
    }

    private string RenderMarkdown(string content)
    {
        if (string.IsNullOrEmpty(content))
            return string.Empty;

        var html = System.Web.HttpUtility.HtmlEncode(content);

        // Bold: **text** or __text__
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"__(.+?)__", "<strong>$1</strong>");

        // Italic: *text* or _text_
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*(.+?)\*", "<em>$1</em>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"_(.+?)_", "<em>$1</em>");

        // Strikethrough: ~~text~~
        html = System.Text.RegularExpressions.Regex.Replace(html, @"~~(.+?)~~", "<del>$1</del>");

        // Inline code: `code`
        html = System.Text.RegularExpressions.Regex.Replace(html, @"`(.+?)`", "<code>$1</code>");

        // Bullet lists: - item
        html = System.Text.RegularExpressions.Regex.Replace(html, @"(?:^|\n)- (.+)", "<li>$1</li>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"(<li>.*</li>)", "<ul>$1</ul>");

        // Numbered lists: 1. item
        html = System.Text.RegularExpressions.Regex.Replace(html, @"(?:^|\n)\d+\. (.+)", "<li>$1</li>");
        if (html.Contains("<li>") && !html.Contains("<ul>"))
        {
            html = System.Text.RegularExpressions.Regex.Replace(html, @"(<li>.*</li>)", "<ol>$1</ol>");
        }

        // Line breaks
        html = html.Replace("\n", "<br>");

        // Wrap in paragraphs if no block elements
        if (!html.Contains("<ul>") && !html.Contains("<ol>"))
        {
            html = "<p>" + html + "</p>";
        }

        return html;
    }

    private string FormatTime(DateTime dateTime)
    {
        var now = DateTime.UtcNow;
        var diff = now - dateTime;

        if (diff.TotalMinutes < 1)
            return Localizer["Time.JustNow"];
        if (diff.TotalMinutes < 60)
            return string.Format(Localizer["Time.MinutesAgo"], (int)diff.TotalMinutes);
        if (diff.TotalHours < 24)
            return string.Format(Localizer["Time.HoursAgo"], (int)diff.TotalHours);
        if (diff.TotalDays < 7)
            return string.Format(Localizer["Time.DaysAgo"], (int)diff.TotalDays);

        return dateTime.ToString("MMM dd, yyyy");
    }
}
