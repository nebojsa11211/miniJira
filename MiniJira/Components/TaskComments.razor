@using MiniJira.Data
@using MiniJira.Models
@using MiniJira.Resources
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@inject ApplicationDbContext DbContext
@inject IServiceProvider ServiceProvider
@inject IStringLocalizer<Localization> Localizer

<div id="task-comments-section" class="task-comments-section">
    <h3 class="section-title">@Localizer["Comments.Title"]</h3>

    @* Add Comment Form *@
    <div id="add-comment-form" class="add-comment-form">
        <div id="formatting-toolbar" class="formatting-toolbar">
            <button type="button" class="format-btn" @onclick="@(() => InsertFormatting("**", "**", "bold text"))" title="@Localizer["Tooltip.FormatBold"]">
                <strong>B</strong>
            </button>
            <button type="button" class="format-btn" @onclick="@(() => InsertFormatting("_", "_", "italic text"))" title="@Localizer["Tooltip.FormatItalic"]">
                <em>I</em>
            </button>
            <button type="button" class="format-btn" @onclick="@(() => InsertFormatting("~~", "~~", "strikethrough"))" title="@Localizer["Tooltip.FormatStrikethrough"]">
                <s>S</s>
            </button>
            <button type="button" class="format-btn" @onclick="@(() => InsertFormatting("`", "`", "code"))" title="@Localizer["Tooltip.FormatCode"]">
                <span style="font-family: monospace;">&lt;/&gt;</span>
            </button>
            <div class="toolbar-separator"></div>
            <button type="button" class="format-btn" @onclick="@(() => InsertFormatting("\n- ", "", "list item"))" title="@Localizer["Tooltip.FormatBulletList"]">
                ≡
            </button>
            <button type="button" class="format-btn" @onclick="@(() => InsertFormatting("\n1. ", "", "numbered item"))" title="@Localizer["Tooltip.FormatNumberedList"]">
                #
            </button>
            <div class="toolbar-separator"></div>
            <div id="emoji-dropdown" class="emoji-dropdown">
                <button type="button" class="format-btn" @onclick="ToggleEmojiPicker" title="@Localizer["Tooltip.AddEmoji"]">
                    😀
                </button>
                @if (showEmojiPicker)
                {
                    <div id="emoji-picker" class="emoji-picker">
                        @foreach (var emoji in commonEmojis)
                        {
                            <button type="button" class="emoji-btn" @onclick="@(() => InsertEmoji(emoji))">@emoji</button>
                        }
                    </div>
                }
            </div>
        </div>
        <textarea @ref="commentTextarea"
                  class="comment-input"
                  placeholder="@Localizer["Comments.AddPlaceholder"]"
                  rows="4"
                  @bind="newCommentText"
                  @bind:event="oninput"
                  title="@Localizer["Tooltip.AddComment"]"></textarea>
        <div id="comment-actions" class="comment-actions">
            <button class="btn btn-primary btn-sm"
                    @onclick="AddComment"
                    disabled="@(string.IsNullOrWhiteSpace(newCommentText) || isSaving)"
                    title="@Localizer["Tooltip.AddComment"]">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>@Localizer["Settings.Saving"]</span>
                }
                else
                {
                    <span>@Localizer["Comments.AddButton"]</span>
                }
            </button>
        </div>
    </div>

    @* Comments List Grouped by Phase *@
    @if (isLoading)
    {
        <div id="comments-loading-container" class="loading-container">
            <div class="spinner-border spinner-border-sm" role="status">
                <span class="visually-hidden">@Localizer["Common.Loading"]</span>
            </div>
            <span class="ms-2">@Localizer["Comments.Loading"]</span>
        </div>
    }
    else if (commentsByPhase.Any())
    {
        <div id="comments-container" class="comments-container">
            @foreach (var phase in commentsByPhase.OrderByDescending(p => p.Key.Order))
            {
                <div id="phase-group-@phase.Key.ColumnId" class="phase-group">
                    <div id="phase-header-@phase.Key.ColumnId" class="phase-header" style="border-left-color: @phase.Key.Column.Color">
                        <span class="phase-name" style="color: @phase.Key.Column.Color">@phase.Key.ColumnName</span>
                        <span class="phase-count">@phase.Value.Count @(phase.Value.Count == 1 ? Localizer["Comments.Comment"] : Localizer["Comments.Comments"])</span>
                    </div>
                    <div id="phase-comments-@phase.Key.ColumnId" class="phase-comments">
                        @foreach (var comment in phase.Value.OrderBy(c => c.CreatedAt))
                        {
                            var canEditDelete = comment.ColumnId == ColumnId; // Can only edit/delete if task is in the same phase
                            var isEditing = editingCommentId == comment.Id;

                            <div id="comment-item-@comment.Id" class="comment-item">
                                <div id="comment-header-@comment.Id" class="comment-header">
                                    <div id="comment-author-@comment.Id" class="comment-author">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        <span>@(comment.CreatedBy ?? Localizer["Comments.Anonymous"])</span>
                                    </div>
                                    <div id="comment-header-right-@comment.Id" class="comment-header-right">
                                        <div class="comment-time">@FormatTime(comment.CreatedAt)</div>
                                        @if (canEditDelete && !isEditing)
                                        {
                                            <div id="comment-actions-buttons-@comment.Id" class="comment-actions-buttons">
                                                <button class="btn-icon" @onclick="() => StartEditComment(comment)" title="@Localizer["Tooltip.EditComment"]">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                                    </svg>
                                                </button>
                                                <button class="btn-icon btn-danger" @onclick="() => DeleteComment(comment.Id)" title="@Localizer["Tooltip.DeleteComment"]">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                                    </svg>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (isEditing)
                                {
                                    <div id="edit-comment-form-@comment.Id" class="edit-comment-form">
                                        <div id="edit-formatting-toolbar-@comment.Id" class="formatting-toolbar">
                                            <button type="button" class="format-btn" @onclick="@(() => InsertFormattingEdit("**", "**", "bold text"))" title="@Localizer["Tooltip.FormatBold"]">
                                                <strong>B</strong>
                                            </button>
                                            <button type="button" class="format-btn" @onclick="@(() => InsertFormattingEdit("_", "_", "italic text"))" title="@Localizer["Tooltip.FormatItalic"]">
                                                <em>I</em>
                                            </button>
                                            <button type="button" class="format-btn" @onclick="@(() => InsertFormattingEdit("~~", "~~", "strikethrough"))" title="@Localizer["Tooltip.FormatStrikethrough"]">
                                                <s>S</s>
                                            </button>
                                            <button type="button" class="format-btn" @onclick="@(() => InsertFormattingEdit("`", "`", "code"))" title="@Localizer["Tooltip.FormatCode"]">
                                                <span style="font-family: monospace;">&lt;/&gt;</span>
                                            </button>
                                            <div class="toolbar-separator"></div>
                                            <button type="button" class="format-btn" @onclick="@(() => InsertEmojiEdit("👍"))" title="@Localizer["Emoji.ThumbsUp"]">👍</button>
                                            <button type="button" class="format-btn" @onclick="@(() => InsertEmojiEdit("✅"))" title="@Localizer["Emoji.Check"]">✅</button>
                                            <button type="button" class="format-btn" @onclick="@(() => InsertEmojiEdit("❌"))" title="@Localizer["Emoji.Cross"]">❌</button>
                                            <button type="button" class="format-btn" @onclick="@(() => InsertEmojiEdit("😀"))" title="@Localizer["Emoji.Smile"]">😀</button>
                                        </div>
                                        <textarea @ref="editTextarea"
                                                  class="comment-input"
                                                  rows="3"
                                                  @bind="editCommentText"
                                                  @bind:event="oninput"></textarea>
                                        <div id="edit-comment-actions-@comment.Id" class="edit-comment-actions">
                                            <button class="btn btn-primary btn-sm"
                                                    @onclick="SaveEditComment"
                                                    disabled="@(string.IsNullOrWhiteSpace(editCommentText) || isSaving)"
                                                    title="@Localizer["Tooltip.SaveComment"]">
                                                @if (isSaving)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                                    <span>@Localizer["Settings.Saving"]</span>
                                                }
                                                else
                                                {
                                                    <span>@Localizer["Comments.Save"]</span>
                                                }
                                            </button>
                                            <button class="btn btn-secondary btn-sm"
                                                    @onclick="CancelEditComment"
                                                    disabled="@isSaving"
                                                    title="@Localizer["Tooltip.Cancel"]">
                                                @Localizer["Comments.Cancel"]
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div id="comment-content-@comment.Id" class="comment-content">@((MarkupString)RenderMarkdown(comment.Content))</div>
                                    @if (comment.UpdatedAt.HasValue)
                                    {
                                        <div id="comment-edited-@comment.Id" class="comment-edited">@string.Format(Localizer["Comments.Edited"], FormatTime(comment.UpdatedAt.Value))</div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div id="no-comments" class="no-comments">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" opacity="0.3">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <p>@Localizer["Comments.NoComments"]</p>
        </div>
    }
</div>

