    .comment-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
    }

    .comment-author {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        color: var(--jira-text-primary);
        font-size: 0.95rem;
    }

    .comment-author svg {
        color: var(--jira-text-secondary);
    }

    .comment-header-right {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .comment-time {
        font-size: 0.875rem;
        color: var(--jira-text-secondary);
    }

    .comment-actions-buttons {
        display: flex;
        gap: 0.25rem;
