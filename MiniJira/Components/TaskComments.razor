        border-radius: var(--jira-radius-large);
        box-shadow: var(--jira-shadow-card);
    }

    .section-title {
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--jira-text-primary);
    }

    .add-comment-form {
        margin-bottom: 1.5rem;
        padding: 1rem;
        background: var(--jira-bg-secondary);
        border-radius: var(--jira-radius-small);
        border: 1px solid var(--jira-border);
    }

    .formatting-toolbar {
        display: flex;
        gap: 0.25rem;
        align-items: center;
        padding: 0.5rem;
        background: var(--jira-bg-primary);
        border: 1px solid var(--jira-border);
        border-bottom: none;
        border-radius: var(--jira-radius-small) var(--jira-radius-small) 0 0;
    }

    .format-btn {
        background: transparent;
        border: 1px solid transparent;
        padding: 0.4rem 0.6rem;
        cursor: pointer;
        color: var(--jira-text-primary);
        border-radius: var(--jira-radius-small);
        transition: all 0.2s;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 32px;
        height: 32px;
    }

    .format-btn:hover {
        background: var(--jira-bg-secondary);
        border-color: var(--jira-border);
    }

    .toolbar-separator {
        width: 1px;
        height: 24px;
        background: var(--jira-border);
        margin: 0 0.5rem;
    }

    .emoji-dropdown {
        position: relative;
    }

    .emoji-picker {
        position: absolute;
        top: 100%;
        left: 0;
        margin-top: 0.25rem;
        background: var(--jira-bg-primary);
        border: 1px solid var(--jira-border);
        border-radius: var(--jira-radius-small);
        box-shadow: var(--jira-shadow-card);
        padding: 0.5rem;
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        gap: 0.25rem;
        z-index: 1000;
        max-width: 320px;
    }

    .emoji-btn {
        background: transparent;
        border: 1px solid transparent;
        padding: 0.4rem;
        cursor: pointer;
        border-radius: var(--jira-radius-small);
        font-size: 1.2rem;
        transition: all 0.2s;
        min-width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .emoji-btn:hover {
        background: var(--jira-bg-secondary);
        border-color: var(--jira-border);
        transform: scale(1.1);
    }

    .comment-input {
        width: 100%;
        padding: 0.75rem;
