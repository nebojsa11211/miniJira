                        <li>@Localizer["UserGuide.Section2.5.Show.Step3"]</li>
                    </ol>
                </div>
            </div>
        </div>

        <div class="subsection">
            <h3>@Localizer["UserGuide.Section2.6.Title"]</h3>

            <div class="info-box warning">
