        margin-bottom: 0.5rem;
        color: var(--text-secondary);
    }

    /* Column Showcase */
    .column-showcase {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin: 1.5rem 0;
    }

    .column-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 1.5rem;
    }

    .column-card h4 {
        margin: 0 0 0.5rem 0;
