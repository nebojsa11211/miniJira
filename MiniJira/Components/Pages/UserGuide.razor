            <p>@Localizer["UserGuide.Section2.4.Intro"]</p>

            <div class="screenshot-placeholder">
                <img src="/images/guide/07-drag-drop.png" alt="Drag and Drop" class="guide-screenshot" />
                <p class="screenshot-caption">@Localizer["UserGuide.Section2.4.Caption"]</p>
            </div>

            <ol class="step-list">
                <li>@Localizer["UserGuide.Section2.4.StepList1"]</li>
                <li>@Localizer["UserGuide.Section2.4.StepList2"]</li>
                <li>@Localizer["UserGuide.Section2.4.StepList3"]</li>
                <li>@Localizer["UserGuide.Section2.4.StepList4"]</li>
            </ol>
        </div>

        <div class="subsection">
            <h3>@Localizer["UserGuide.Section2.5.Title"]</h3>
