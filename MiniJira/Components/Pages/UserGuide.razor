        margin: 0.5rem 0;
    }

    /* Use Case Cards */
    .use-case-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .use-case-card h4 {
        margin: 0 0 0.5rem 0;
        color: var(--text-primary);
    }

    .use-case-card p {
        margin-bottom: 1rem;
    }

    /* Palette Showcase */
    .palette-showcase {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin: 1.5rem 0;
    }

    .palette-option {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 1rem;
        text-align: center;
    }

    .palette-option h4 {
        margin: 0 0 0.5rem 0;
        color: var(--text-primary);
    }

    .palette-option p {
        margin: 0;
        color: var(--text-secondary);
        font-size: 0.875rem;
    }

    /* Help Section */
    .help-section {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 2px solid var(--border-color);
    }

    .help-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 2rem;
        text-align: center;
    }

    .help-card h2 {
        margin: 0 0 1rem 0;
