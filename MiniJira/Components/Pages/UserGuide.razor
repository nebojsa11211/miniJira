<style>
    /* User Guide Styles */
    .user-guide-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
        background: var(--bg-primary);
        min-height: 100vh;
    }

    /* Hero Section */
    .guide-hero {
        text-align: center;
        padding: 3rem 0;
        border-bottom: 2px solid var(--border-color);
        margin-bottom: 3rem;
    }

    .guide-hero h1 {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        font-size: 2.5rem;
        color: var(--text-primary);
        margin: 0;
    }

    .hero-icon {
        color: var(--primary-color);
    }

    .hero-subtitle {
        font-size: 1.25rem;
        color: var(--text-secondary);
        margin-top: 1rem;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
    }

    /* Table of Contents */
    .toc-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 2rem;
        margin-bottom: 3rem;
    }

    .toc-card h2 {
        margin: 0 0 1.5rem 0;
        color: var(--text-primary);
    }

    .toc-nav {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .toc-link {
        display: block;
        padding: 0.75rem 1rem;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        color: var(--text-primary);
        text-decoration: none;
        transition: all 0.2s;
    }

    .toc-link:hover {
        background: var(--bg-hover);
        border-color: var(--primary-color);
        transform: translateX(4px);
    }

    /* Guide Sections */
    .guide-section {
        margin-bottom: 4rem;
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid var(--primary-color);
        margin-bottom: 2rem;
    }

    .section-number {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        background: var(--primary-color);
        color: white;
        border-radius: 50%;
        font-size: 1.5rem;
        font-weight: bold;
    }

    .section-header h2 {
        margin: 0;
        color: var(--text-primary);
    }

    /* Subsections */
    .subsection {
        margin-bottom: 2.5rem;
    }

    .subsection h3 {
        color: var(--primary-color);
        margin-bottom: 1rem;
    }

    .subsection p {
        color: var(--text-secondary);
        line-height: 1.6;
        margin-bottom: 1rem;
    }

    /* Step Cards */
    .step-card {
        display: flex;
        gap: 1rem;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .step-number {
        flex-shrink: 0;
        width: 48px;
        height: 48px;
        background: var(--primary-color);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.875rem;
    }

    .step-content {
        flex: 1;
    }

    .step-content h4 {
        margin: 0 0 0.5rem 0;
        color: var(--text-primary);
    }

    /* Info Boxes */
    .info-box {
        display: flex;
        gap: 1rem;
        padding: 1rem;
        border-radius: 6px;
        margin: 1rem 0;
    }

    .info-box.info {
        background: #e3f2fd;
        border-left: 4px solid #2196f3;
    }

    .info-box.success {
        background: #e8f5e9;
        border-left: 4px solid #4caf50;
    }

    .info-box.warning {
        background: #fff3e0;
        border-left: 4px solid #ff9800;
    }

    .info-box.tip {
        background: #f3e5f5;
        border-left: 4px solid #9c27b0;
    }

    .info-icon {
        flex-shrink: 0;
    }

    .info-box p {
        margin: 0;
        color: var(--text-primary);
    }

    /* Screenshot Placeholder */
    .screenshot-placeholder {
        margin: 1.5rem 0;
    }

    .guide-screenshot {
        width: 100%;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
