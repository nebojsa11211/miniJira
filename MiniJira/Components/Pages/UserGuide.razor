        text-align: center;
        color: var(--text-secondary);
        font-size: 0.875rem;
        margin-top: 0.5rem;
        font-style: italic;
    }

    /* Feature Grid */
    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
        margin: 1.5rem 0;
