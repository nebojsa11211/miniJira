@page "/user-guide"
@using MiniJira.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Localization> Localizer

<PageTitle>@Localizer["UserGuide.PageTitle"]</PageTitle>

<AuthGuard>
<div class="user-guide-container">
    <!-- Hero Section -->
    <div class="guide-hero">
        <h1>
            <svg class="hero-icon" width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
            </svg>
            @Localizer["UserGuide.Hero.Title"]
        </h1>
        <p class="hero-subtitle">@Localizer["UserGuide.Hero.Subtitle"]</p>
    </div>

    <!-- Table of Contents -->
    <div class="toc-card">
        <h2>@Localizer["UserGuide.TOC.Title"]</h2>
        <nav class="toc-nav">
            <a href="#getting-started" class="toc-link">@Localizer["UserGuide.TOC.Section1"]</a>
            <a href="#managing-tasks" class="toc-link">@Localizer["UserGuide.TOC.Section2"]</a>
            <a href="#working-columns" class="toc-link">@Localizer["UserGuide.TOC.Section3"]</a>
            <a href="#reports" class="toc-link">@Localizer["UserGuide.TOC.Section4"]</a>
            <a href="#settings" class="toc-link">@Localizer["UserGuide.TOC.Section5"]</a>
            <a href="#tips" class="toc-link">@Localizer["UserGuide.TOC.Section6"]</a>
        </nav>
    </div>

    <!-- Section 1: Getting Started -->
    <section id="getting-started" class="guide-section">
        <div class="section-header">
            <span class="section-number">1</span>
            <h2>@Localizer["UserGuide.Section1.Title"]</h2>
        </div>

        <div class="subsection">
            <h3>@Localizer["UserGuide.Section1.1.Title"]</h3>
            <p>@Localizer["UserGuide.Section1.1.Intro"]</p>

            <div class="step-card">
                <div class="step-number">@Localizer["UserGuide.Section1.1.Step1.Label"]</div>
                <div class="step-content">
                    <h4>@Localizer["UserGuide.Section1.1.Step1.Title"]</h4>
                    <p>@Localizer["UserGuide.Section1.1.Step1.Text"]</p>
                    <div class="screenshot-placeholder">
                        <img src="/images/guide/01-user-selection.png" alt="User Selection Screen" class="guide-screenshot" />
                        <p class="screenshot-caption">@Localizer["UserGuide.Section1.1.Step1.Caption"]</p>
                    </div>
                </div>
            </div>

            <div class="info-box info">
                <svg class="info-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                </svg>
                <p><strong>@Localizer["UserGuide.Section1.1.Note"]</strong> @Localizer["UserGuide.Section1.1.NoteText"]</p>
            </div>
        </div>

        <div class="subsection">
            <h3>@Localizer["UserGuide.Section1.2.Title"]</h3>
            <p>@Localizer["UserGuide.Section1.2.Intro"]</p>

            <div class="screenshot-placeholder">
                <img src="/images/guide/02-main-dashboard.png" alt="Main Dashboard" class="guide-screenshot" />
                <p class="screenshot-caption">@Localizer["UserGuide.Section1.2.Caption"]</p>
            </div>

            <div class="feature-grid">
                <div class="feature-item">
                    <div class="feature-icon">📋</div>
                    <h4>@Localizer["UserGuide.Section1.2.Feature1.Title"]</h4>
                    <p>@Localizer["UserGuide.Section1.2.Feature1.Text"]</p>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">➕</div>
                    <h4>@Localizer["UserGuide.Section1.2.Feature2.Title"]</h4>
                    <p>@Localizer["UserGuide.Section1.2.Feature2.Text"]</p>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">🔍</div>
                    <h4>@Localizer["UserGuide.Section1.2.Feature3.Title"]</h4>
                    <p>@Localizer["UserGuide.Section1.2.Feature3.Text"]</p>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">🎨</div>
                    <h4>@Localizer["UserGuide.Section1.2.Feature4.Title"]</h4>
                    <p>@Localizer["UserGuide.Section1.2.Feature4.Text"]</p>
                </div>
            </div>
        </div>

        <div class="subsection">
            <h3>@Localizer["UserGuide.Section1.3.Title"]</h3>
            <p>@Localizer["UserGuide.Section1.3.Intro"]</p>

            <div class="screenshot-placeholder">
                <img src="/images/guide/03-sidebar.png" alt="Navigation Sidebar" class="guide-screenshot" />
                <p class="screenshot-caption">@Localizer["UserGuide.Section1.3.Caption"]</p>
            </div>

            <div class="nav-list">
                <div class="nav-section">
                    <h4>@Localizer["UserGuide.Section1.3.PlanningTitle"]</h4>
                    <ul>
                        <li><strong>@Localizer["UserGuide.Section1.3.Planning.Home"]</strong> - @Localizer["UserGuide.Section1.3.Planning.HomeDesc"]</li>
                        <li><strong>@Localizer["UserGuide.Section1.3.Planning.Reports"]</strong> - @Localizer["UserGuide.Section1.3.Planning.ReportsDesc"]</li>
                    </ul>
                </div>
                <div class="nav-section">
                    <h4>@Localizer["UserGuide.Section1.3.DevelopmentTitle"]</h4>
                    <ul>
                        <li><strong>@Localizer["UserGuide.Section1.3.Development.HiddenTasks"]</strong> - @Localizer["UserGuide.Section1.3.Development.HiddenTasksDesc"]</li>
                        <li><strong>@Localizer["UserGuide.Section1.3.Development.ColumnManagement"]</strong> - @Localizer["UserGuide.Section1.3.Development.ColumnManagementDesc"]</li>
                    </ul>
                </div>
                <div class="nav-section">
                    <h4>@Localizer["UserGuide.Section1.3.SettingsTitle"]</h4>
                    <ul>
                        <li><strong>@Localizer["UserGuide.Section1.3.Settings.Settings"]</strong> - @Localizer["UserGuide.Section1.3.Settings.SettingsDesc"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 2: Managing Tasks -->
