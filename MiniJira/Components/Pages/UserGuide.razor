        <div class="subsection">
            <h3>@Localizer["UserGuide.Section2.3.Title"]</h3>
            <p>@Localizer["UserGuide.Section2.3.Intro"]</p>

            <ol class="step-list">
                <li>@Localizer["UserGuide.Section2.3.StepList1"]</li>
