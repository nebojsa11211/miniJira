        margin: 0.5rem 0;
        color: var(--text-primary);
    }

    .feature-item p {
        margin: 0;
        color: var(--text-secondary);
        font-size: 0.875rem;
    }

    /* Lists */
    .step-list, .field-list, .checklist, .priority-list {
        margin: 1rem 0;
        padding-left: 1.5rem;
    }

    .step-list li, .field-list li, .checklist li, .priority-list li {
        margin-bottom: 0.5rem;
        color: var(--text-secondary);
        line-height: 1.6;
    }

    /* Navigation List */
    .nav-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .nav-section {
        background: var(--card-bg);
