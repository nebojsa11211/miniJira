@page "/reports"
@using MiniJira.Models
@using MiniJira.Services
@using MiniJira.Services.DTOs
@using MiniJira.Resources
@using Microsoft.Extensions.Localization
@inject ITaskService TaskService
@inject ICurrentUserService CurrentUserService
@inject IStringLocalizer<Localization> Localizer

<PageTitle>@Localizer["Nav.Reports"] - MiniJira</PageTitle>

<AuthGuard>
<div id="reports-container" class="reports-container">
    <div id="reports-header" class="reports-header">
        <h1>@Localizer["Nav.Reports"]</h1>
        <p id="reports-subtitle" class="reports-subtitle">@Localizer["Reports.Subtitle"]</p>
    </div>

    @if (isLoading)
    {
        <div id="reports-loading-container" class="loading-container">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">@Localizer["Common.Loading"]</span>
            </div>
            <p class="loading-text">@Localizer["Reports.LoadingReports"]</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div id="reports-error-message" class="alert alert-danger" role="alert">
            <strong>@Localizer["Common.Error"]</strong> @errorMessage
        </div>
    }
    else
    {
        <!-- Summary Cards -->
        <div id="stats-grid" class="stats-grid">
            <div id="stat-card-total" class="stat-card">
                <div class="stat-icon total">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" fill="currentColor"/>
                    </svg>
                </div>
                <div class="stat-content">
                    <div class="stat-label">@Localizer["Reports.TotalTasks"]</div>
                    <div class="stat-value">@totalTasks</div>
                </div>
            </div>

            <div id="stat-card-completed" class="stat-card">
                <div class="stat-icon completed">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" fill="currentColor"/>
                    </svg>
                </div>
                <div class="stat-content">
                    <div class="stat-label">@Localizer["Reports.CompletedTasks"]</div>
                    <div class="stat-value">@completedTasks</div>
                    <div class="stat-percentage">@completionRate%</div>
                </div>
            </div>

            <div id="stat-card-in-progress" class="stat-card">
                <div class="stat-icon in-progress">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" fill="currentColor"/>
                    </svg>
                </div>
                <div class="stat-content">
                    <div class="stat-label">@Localizer["Reports.InProgress"]</div>
                    <div class="stat-value">@inProgressTasks</div>
                </div>
            </div>

            <div id="stat-card-todo" class="stat-card">
                <div class="stat-icon todo">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" fill="currentColor"/>
                    </svg>
                </div>
                <div class="stat-content">
                    <div class="stat-label">@Localizer["Reports.ToDo"]</div>
                    <div class="stat-value">@todoTasks</div>
                </div>
            </div>
        </div>

        <!-- Status Distribution -->
        <div id="report-section-status" class="report-section">
            <h2 class="section-title">@Localizer["Reports.StatusDistribution"]</h2>
            <div id="chart-container-status" class="chart-container">
                <div id="bar-chart-status" class="bar-chart">
                    @foreach (var stat in statusStats)
                    {
                        var percentage = totalTasks > 0 ? (stat.Count * 100.0 / totalTasks) : 0;
                        <div class="bar-item">
                            <div class="bar-label">@stat.Label</div>
                            <div class="bar-wrapper">
                                <div class="bar-fill @GetStatusClass(stat.Label)" style="width: @percentage%"></div>
                                <span class="bar-value">@stat.Count (@percentage.ToString("F1")%)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Priority Distribution -->
        <div id="report-section-priority" class="report-section">
            <h2 class="section-title">@Localizer["Reports.PriorityDistribution"]</h2>
            <div id="chart-container-priority" class="chart-container">
                <div id="bar-chart-priority" class="bar-chart">
                    @foreach (var stat in priorityStats)
                    {
                        var percentage = totalTasks > 0 ? (stat.Count * 100.0 / totalTasks) : 0;
                        <div class="bar-item">
                            <div class="bar-label">@stat.Label</div>
                            <div class="bar-wrapper">
                                <div class="bar-fill @GetPriorityClass(stat.Label)" style="width: @percentage%"></div>
                                <span class="bar-value">@stat.Count (@percentage.ToString("F1")%)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Column Distribution -->
        <div id="report-section-column" class="report-section">
            <h2 class="section-title">@Localizer["Reports.TasksByColumn"]</h2>
            <div id="chart-container-column" class="chart-container">
                <div id="bar-chart-column" class="bar-chart">
                    @foreach (var stat in columnStats)
                    {
                        var percentage = totalTasks > 0 ? (stat.Count * 100.0 / totalTasks) : 0;
                        <div class="bar-item">
                            <div class="bar-label">@stat.Label</div>
                            <div class="bar-wrapper">
                                <div class="bar-fill column-bar" style="width: @percentage%; background-color: @stat.Color;"></div>
                                <span class="bar-value">@stat.Count (@percentage.ToString("F1")%)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="report-section">
            <h2 class="section-title">@Localizer["Reports.RecentActivity"]</h2>
            <div class="activity-list">
                @foreach (var task in recentTasks)
                {
                    <div class="activity-item">
                        <div class="activity-icon">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                                <circle cx="8" cy="8" r="7" stroke="currentColor" fill="none" stroke-width="2"/>
                            </svg>
                        </div>
                        <div class="activity-content">
                            <div class="activity-title">@task.Title</div>
                            <div class="activity-meta">
                                <span class="priority-badge priority-@task.Priority.ToString().ToLower()">@task.Priority</span>
                                <span class="activity-date">@Localizer["Reports.Updated"] @GetRelativeTime(task.UpdatedAt)</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
</AuthGuard>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private List<TaskDto> tasks = new();
    private List<TaskDto> recentTasks = new();

    private int totalTasks;
    private int completedTasks;
    private int inProgressTasks;
    private int todoTasks;
    private double completionRate;

    private List<StatItem> statusStats = new();
    private List<StatItem> priorityStats = new();
    private List<ColumnStatItem> columnStats = new();

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        await LoadReports();
    }

    private async System.Threading.Tasks.Task LoadReports()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            tasks = await TaskService.GetAllTasksAsync();

            // Calculate basic stats
            totalTasks = tasks.Count;
            completedTasks = tasks.Count(t => t.Status == Models.TaskStatus.Done);
            inProgressTasks = tasks.Count(t => t.Status == Models.TaskStatus.InProgress);
            todoTasks = tasks.Count(t => t.Status == Models.TaskStatus.ToDo);
            completionRate = totalTasks > 0 ? Math.Round((completedTasks * 100.0 / totalTasks), 1) : 0;

            // Calculate status distribution
            statusStats = new List<StatItem>
            {
                new StatItem { Label = Localizer["Reports.ToDo"], Count = todoTasks },
                new StatItem { Label = Localizer["Reports.InProgress"], Count = inProgressTasks },
                new StatItem { Label = Localizer["TaskStatus.Done"], Count = completedTasks }
            };

            // Calculate priority distribution
            priorityStats = new List<StatItem>
            {
                new StatItem { Label = Localizer["TaskPriority.High"], Count = tasks.Count(t => t.Priority == Models.TaskPriority.High) },
                new StatItem { Label = Localizer["TaskPriority.Medium"], Count = tasks.Count(t => t.Priority == Models.TaskPriority.Medium) },
                new StatItem { Label = Localizer["TaskPriority.Low"], Count = tasks.Count(t => t.Priority == Models.TaskPriority.Low) }
            };

            // Calculate column distribution (group by ColumnId only since TaskDto doesn't have ColumnName/ColumnColor)
            var columnGroups = tasks.Where(t => t.ColumnId.HasValue)
                                   .GroupBy(t => t.ColumnId!.Value)
                                   .Select(g => new ColumnStatItem
                                   {
                                       Label = $"{Localizer["Reports.Column"]} {g.Key.ToString().Substring(0, 8)}",
                                       Count = g.Count(),
                                       Color = "#6B778C"
                                   })
                                   .OrderByDescending(c => c.Count)
                                   .ToList();
            columnStats = columnGroups;

            // Get recent tasks (updated in last 7 days)
            recentTasks = tasks.OrderByDescending(t => t.UpdatedAt)
                              .Take(10)
                              .ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load reports: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusClass(string status)
    {
        // Handle both English and localized status labels
        if (status == Localizer["Reports.ToDo"] || status == "To Do")
            return "status-todo";
        if (status == Localizer["Reports.InProgress"] || status == "In Progress")
            return "status-inprogress";
        if (status == Localizer["TaskStatus.Done"] || status == "Done")
            return "status-done";
        return "status-default";
    }

    private string GetPriorityClass(string priority)
    {
        return $"priority-{priority.ToLower()}";
    }

    private string GetRelativeTime(DateTime date)
    {
        var timeSpan = DateTime.UtcNow - date;

        if (timeSpan.TotalMinutes < 1) return Localizer["Time.JustNowLong"];
        if (timeSpan.TotalMinutes < 60) return string.Format(Localizer["Time.MinutesAgoFormat"], (int)timeSpan.TotalMinutes);
        if (timeSpan.TotalHours < 24) return string.Format(Localizer["Time.HoursAgoFormat"], (int)timeSpan.TotalHours);
        if (timeSpan.TotalDays < 7) return string.Format(Localizer["Time.DaysAgoFormat"], (int)timeSpan.TotalDays);
        if (timeSpan.TotalDays < 30) return string.Format(Localizer["Time.WeeksAgo"], (int)(timeSpan.TotalDays / 7));
        if (timeSpan.TotalDays < 365) return string.Format(Localizer["Time.MonthsAgo"], (int)(timeSpan.TotalDays / 30));
        return string.Format(Localizer["Time.YearsAgo"], (int)(timeSpan.TotalDays / 365));
    }

    private class StatItem
    {
        public string Label { get; set; } = string.Empty;
        public int Count { get; set; }
    }

    private class ColumnStatItem
    {
        public string Label { get; set; } = string.Empty;
        public int Count { get; set; }
        public string Color { get; set; } = string.Empty;
    }
}
