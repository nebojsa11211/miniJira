@page "/admin/columns"
@using MiniJira.Services.DTOs
@using MiniJira.Resources
@using MiniJira.Components.Shared.Dialogs

<PageTitle>@Localizer["ColumnManagement.Title"] - MiniJira</PageTitle>

<div id="column-management-container" class="column-management-container">
    <div id="column-management-page-header" class="page-header">
        <h1 class="page-title">@Localizer["ColumnManagement.Title"]</h1>
        <button id="create-column-button" class="btn btn-primary" @onclick="ShowCreateDialog" aria-label="@Localizer["ColumnManagement.CreateColumn"]" title="@Localizer["Tooltip.CreateColumn"]">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M10 4V16M4 10H16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            @Localizer["ColumnManagement.CreateColumn"]
        </button>
    </div>

    @if (isLoading)
    {
        <div id="column-management-loading-container" class="loading-container">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">@Localizer["Common.Loading"]</span>
            </div>
            <p class="loading-text">@Localizer["ColumnManagement.LoadingColumns"]</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div id="column-management-error-message" class="alert alert-danger" role="alert">
            <strong>@Localizer["Common.Error"]</strong> @errorMessage
        </div>
    }
    else if (columns.Count == 0)
    {
        <div id="column-management-empty-state" class="empty-state">
            <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="8" y="8" width="16" height="48" rx="2" fill="var(--jira-n50)"/>
                <rect x="28" y="8" width="16" height="48" rx="2" fill="var(--jira-n50)"/>
                <rect x="48" y="8" width="16" height="48" rx="2" fill="var(--jira-n50)"/>
            </svg>
            <p class="empty-text">@Localizer["ColumnManagement.NoColumns"]</p>
            <button id="create-column-empty-button" class="btn btn-primary" @onclick="ShowCreateDialog">
                @Localizer["ColumnManagement.CreateColumn"]
            </button>
        </div>
    }
    else
    {
        <div id="columns-list" class="columns-list" role="list">
            @foreach (var column in columns.OrderBy(c => c.Order))
            {
                <div id="column-item-@column.Id" class="column-item"
                     role="listitem"
                     draggable="@(!column.IsSystem)"
                     @ondragstart="@(() => HandleDragStart(column))"
                     @ondragover:preventDefault
                     @ondrop="@(() => HandleDrop(column))"
                     data-column-id="@column.Id">

                    @if (!column.IsSystem)
                    {
                        <div id="drag-handle-@column.Id" class="drag-handle" aria-label="@Localizer["ColumnManagement.DragHandle"]">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <circle cx="7" cy="5" r="1.5" fill="currentColor"/>
                                <circle cx="13" cy="5" r="1.5" fill="currentColor"/>
                                <circle cx="7" cy="10" r="1.5" fill="currentColor"/>
                                <circle cx="13" cy="10" r="1.5" fill="currentColor"/>
                                <circle cx="7" cy="15" r="1.5" fill="currentColor"/>
                                <circle cx="13" cy="15" r="1.5" fill="currentColor"/>
                            </svg>
                        </div>
                    }

                    <div id="column-color-@column.Id" class="column-color" style="background-color: @column.Color;" aria-hidden="true"></div>

                    <div id="column-content-@column.Id" class="column-content">
                        <div id="column-header-@column.Id" class="column-header">
                            <h3 class="column-name">@column.Name</h3>
                            @if (column.IsSystem)
                            {
                                <span class="system-badge" aria-label="@Localizer["ColumnManagement.SystemColumn"]">
                                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                        <path d="M7 1L8.5 5.5H13L9.5 8.5L11 13L7 10L3 13L4.5 8.5L1 5.5H5.5L7 1Z" fill="currentColor"/>
                                    </svg>
                                    @Localizer["ColumnManagement.SystemColumn"]
                                </span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(column.Description))
                        {
                            <p class="column-description">@column.Description</p>
                        }

                        <div id="column-meta-@column.Id" class="column-meta">
                            <span class="task-count" aria-label="@string.Format(Localizer["ColumnManagement.TaskCount"], column.TaskCount)">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <rect x="2" y="3" width="12" height="10" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/>
                                    <path d="M5 7H11M5 10H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                </svg>
                                @string.Format(Localizer["ColumnManagement.TaskCount"], column.TaskCount)
                            </span>
                        </div>
                    </div>

                    <div id="column-actions-@column.Id" class="column-actions">
                        <button id="edit-button-@column.Id"
                                class="btn-icon"
                                @onclick="@(() => ShowEditDialog(column))"
                                aria-label="@Localizer["ColumnManagement.EditColumn"]"
                                title="@Localizer["Tooltip.EditColumn"]">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M14.5 2.5L17.5 5.5L7 16H4V13L14.5 2.5Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                        <button id="delete-button-@column.Id"
                                class="btn-icon btn-icon-danger"
                                @onclick="@(() => ShowDeleteDialog(column))"
                                disabled="@(column.IsSystem || column.TaskCount > 0)"
                                aria-label="@Localizer["ColumnManagement.DeleteColumn"]"
                                title="@(column.IsSystem ? Localizer["ColumnManagement.CannotDeleteSystem"] : column.TaskCount > 0 ? Localizer["ColumnManagement.CannotDelete"] : Localizer["Tooltip.DeleteColumn"])">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M3 5H17M8 5V3H12V5M7 8V14M10 8V14M13 8V14M5 5L6 17H14L15 5H5Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    @if (successMessage != null)
    {
        <div id="column-management-success-toast" class="toast-notification toast-success" role="alert" aria-live="polite">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="10" cy="10" r="8" fill="var(--jira-green)"/>
                <path d="M6 10L9 13L14 8" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>@successMessage</span>
            <button id="toast-close-button" class="toast-close" @onclick="ClearSuccessMessage" aria-label="@Localizer["Common.Close"]">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M4 4L12 12M12 4L4 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </button>
        </div>
    }
</div>

@if (showColumnDialog)
{
    <ColumnDialog
        Column="@selectedColumn"
        OnSave="@HandleSaveColumn"
        OnCancel="@HideColumnDialog" />
}

@if (showDeleteConfirmation && columnToDelete != null)
{
    <DeleteColumnDialog
        Column="@columnToDelete"
        OnConfirm="@HandleDeleteColumn"
        OnCancel="@HideDeleteDialog" />
}
